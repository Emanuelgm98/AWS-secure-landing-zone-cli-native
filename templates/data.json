{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Encrypted Aurora PostgreSQL Serverless v2; minimum 0.5 ACU. One writer; optional reader for prod.",
  "Parameters": {
    "Environment": {"Type": "String", "AllowedValues": ["dev", "prod"]},
    "VpcId": {"Type": "AWS::EC2::VPC::Id"},
    "DataSubnetIds": {"Type": "List<AWS::EC2::Subnet::Id>"},
    "ApplicationSecurityGroupId": {"Type": "AWS::EC2::SecurityGroup::Id"},
    "MinACU": {"Type": "Number", "Default": 0.5, "MinValue": 0.5},
    "MaxACU": {"Type": "Number", "Default": 4, "MinValue": 1, "MaxValue": 128},
    "ReaderCount": {"Type": "Number", "Default": 0, "MinValue": 0, "MaxValue": 1}
  },
  "Conditions": {"HasReader": {"Fn::Equals": [{"Ref": "ReaderCount"}, "1"]}},
  "Resources": {
    "DatabaseKey": {"Type": "AWS::KMS::Key", "Properties": {"EnableKeyRotation": true, "KeyPolicy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": {"Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"}}, "Action": "kms:*", "Resource": "*"}]} }},
    "DatabaseSecret": {"Type": "AWS::SecretsManager::Secret", "Properties": {"Description": {"Fn::Sub": "${Environment} Aurora master credential"}, "KmsKeyId": {"Fn::GetAtt": ["DatabaseKey", "Arn"]}, "GenerateSecretString": {"SecretStringTemplate": "{\"username\":\"dbadmin\"}", "GenerateStringKey": "password", "PasswordLength": 32, "ExcludePunctuation": true}}},
    "DatabaseSecurityGroup": {"Type": "AWS::EC2::SecurityGroup", "Properties": {"GroupDescription": "Aurora ingress only from application tasks", "VpcId": {"Ref": "VpcId"}, "SecurityGroupIngress": [{"IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432, "SourceSecurityGroupId": {"Ref": "ApplicationSecurityGroupId"}}]}},
    "DatabaseSubnetGroup": {"Type": "AWS::RDS::DBSubnetGroup", "Properties": {"DBSubnetGroupDescription": "Private data subnets", "SubnetIds": {"Ref": "DataSubnetIds"}}},
    "Cluster": {"Type": "AWS::RDS::DBCluster", "Properties": {"Engine": "aurora-postgresql", "DatabaseName": "appdb", "EngineMode": "provisioned", "Port": 5432, "StorageEncrypted": true, "KmsKeyId": {"Fn::GetAtt": ["DatabaseKey", "Arn"]}, "DBSubnetGroupName": {"Ref": "DatabaseSubnetGroup"}, "VpcSecurityGroupIds": [{"Ref": "DatabaseSecurityGroup"}], "MasterUsername": {"Fn::Sub": "{{resolve:secretsmanager:${DatabaseSecret}:SecretString:username}}"}, "MasterUserPassword": {"Fn::Sub": "{{resolve:secretsmanager:${DatabaseSecret}:SecretString:password}}"}, "ServerlessV2ScalingConfiguration": {"MinCapacity": {"Ref": "MinACU"}, "MaxCapacity": {"Ref": "MaxACU"}}, "BackupRetentionPeriod": 7, "DeletionProtection": {"Fn::Equals": [{"Ref": "Environment"}, "prod"]}}},
    "Writer": {"Type": "AWS::RDS::DBInstance", "Properties": {"DBClusterIdentifier": {"Ref": "Cluster"}, "DBInstanceClass": "db.serverless", "Engine": "aurora-postgresql", "PubliclyAccessible": false}},
    "Reader": {"Type": "AWS::RDS::DBInstance", "Condition": "HasReader", "Properties": {"DBClusterIdentifier": {"Ref": "Cluster"}, "DBInstanceClass": "db.serverless", "Engine": "aurora-postgresql", "PubliclyAccessible": false}}
  },
  "Outputs": {"ClusterEndpoint": {"Value": {"Fn::GetAtt": ["Cluster", "Endpoint.Address"]}}, "SecretArn": {"Value": {"Ref": "DatabaseSecret"}}}
}
