{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Public HTTPS ALB forwarding to private ECS Fargate tasks. Supply an immutable image, certificate and data-stack outputs.",
  "Parameters": {
    "Environment": {"Type": "String", "AllowedValues": ["dev", "prod"]},
    "VpcId": {"Type": "AWS::EC2::VPC::Id"},
    "PublicSubnetIds": {"Type": "List<AWS::EC2::Subnet::Id>"},
    "AppSubnetIds": {"Type": "List<AWS::EC2::Subnet::Id>"},
    "ApplicationSecurityGroupId": {"Type": "AWS::EC2::SecurityGroup::Id"},
    "DatabaseHost": {"Type": "String"},
    "DatabaseSecretArn": {"Type": "String"},
    "ImageUri": {"Type": "String", "Description": "Immutable ECR image URI (prefer digest pinning)"},
    "CertificateArn": {"Type": "String"},
    "DesiredCount": {"Type": "Number", "Default": 1, "MinValue": 1},
    "TaskCpu": {"Type": "String", "Default": "256", "AllowedValues": ["256", "512", "1024", "2048", "4096"]},
    "TaskMemory": {"Type": "String", "Default": "512"}
  },
  "Resources": {
    "Cluster": {"Type": "AWS::ECS::Cluster", "Properties": {"ClusterSettings": [{"Name": "containerInsights", "Value": "enabled"}]}},
    "LogGroup": {"Type": "AWS::Logs::LogGroup", "Properties": {"LogGroupName": {"Fn::Sub": "/slz/${Environment}/app"}, "RetentionInDays": 30}},
    "TaskExecutionRole": {"Type": "AWS::IAM::Role", "Properties": {"AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]}, "ManagedPolicyArns": ["arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"], "Policies": [{"PolicyName": "ReadDatabaseSecret", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": ["secretsmanager:GetSecretValue"], "Resource": {"Ref": "DatabaseSecretArn"}}]}}]}},
    "TaskRole": {"Type": "AWS::IAM::Role", "Properties": {"AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]}}},
    "LoadBalancerSecurityGroup": {"Type": "AWS::EC2::SecurityGroup", "Properties": {"GroupDescription": "Public HTTPS ingress", "VpcId": {"Ref": "VpcId"}, "SecurityGroupIngress": [{"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0"}]}},
    "TaskIngressFromAlb": {"Type": "AWS::EC2::SecurityGroupIngress", "Properties": {"GroupId": {"Ref": "ApplicationSecurityGroupId"}, "IpProtocol": "tcp", "FromPort": 8080, "ToPort": 8080, "SourceSecurityGroupId": {"Ref": "LoadBalancerSecurityGroup"}}},
    "LoadBalancer": {"Type": "AWS::ElasticLoadBalancingV2::LoadBalancer", "Properties": {"Scheme": "internet-facing", "Type": "application", "Subnets": {"Ref": "PublicSubnetIds"}, "SecurityGroups": [{"Ref": "LoadBalancerSecurityGroup"}]}},
    "TargetGroup": {"Type": "AWS::ElasticLoadBalancingV2::TargetGroup", "Properties": {"VpcId": {"Ref": "VpcId"}, "Port": 8080, "Protocol": "HTTP", "TargetType": "ip", "HealthCheckPath": "/health", "Matcher": {"HttpCode": "200-399"}}},
    "HttpsListener": {"Type": "AWS::ElasticLoadBalancingV2::Listener", "Properties": {"LoadBalancerArn": {"Ref": "LoadBalancer"}, "Port": 443, "Protocol": "HTTPS", "Certificates": [{"CertificateArn": {"Ref": "CertificateArn"}}], "DefaultActions": [{"Type": "forward", "TargetGroupArn": {"Ref": "TargetGroup"}}]}},
    "TaskDefinition": {"Type": "AWS::ECS::TaskDefinition", "Properties": {"Family": {"Fn::Sub": "${Environment}-app"}, "NetworkMode": "awsvpc", "RequiresCompatibilities": ["FARGATE"], "Cpu": {"Ref": "TaskCpu"}, "Memory": {"Ref": "TaskMemory"}, "ExecutionRoleArn": {"Fn::GetAtt": ["TaskExecutionRole", "Arn"]}, "TaskRoleArn": {"Fn::GetAtt": ["TaskRole", "Arn"]}, "ContainerDefinitions": [{"Name": "app", "Image": {"Ref": "ImageUri"}, "Essential": true, "PortMappings": [{"ContainerPort": 8080, "Protocol": "tcp"}], "Environment": [{"Name": "DB_HOST", "Value": {"Ref": "DatabaseHost"}}, {"Name": "DB_NAME", "Value": "appdb"}], "Secrets": [{"Name": "DB_USER", "ValueFrom": {"Fn::Sub": "${DatabaseSecretArn}:username::"}}, {"Name": "DB_PASSWORD", "ValueFrom": {"Fn::Sub": "${DatabaseSecretArn}:password::"}}], "LogConfiguration": {"LogDriver": "awslogs", "Options": {"awslogs-group": {"Ref": "LogGroup"}, "awslogs-region": {"Ref": "AWS::Region"}, "awslogs-stream-prefix": "app"}}}]}},
    "Service": {"Type": "AWS::ECS::Service", "DependsOn": ["HttpsListener", "TaskIngressFromAlb"], "Properties": {"Cluster": {"Ref": "Cluster"}, "DesiredCount": {"Ref": "DesiredCount"}, "LaunchType": "FARGATE", "PlatformVersion": "1.4.0", "TaskDefinition": {"Ref": "TaskDefinition"}, "DeploymentConfiguration": {"MinimumHealthyPercent": 100, "MaximumPercent": 200}, "NetworkConfiguration": {"AwsvpcConfiguration": {"AssignPublicIp": "DISABLED", "Subnets": {"Ref": "AppSubnetIds"}, "SecurityGroups": [{"Ref": "ApplicationSecurityGroupId"}]}}, "LoadBalancers": [{"ContainerName": "app", "ContainerPort": 8080, "TargetGroupArn": {"Ref": "TargetGroup"}}]}}
  },
  "Outputs": {"LoadBalancerDns": {"Value": {"Fn::GetAtt": ["LoadBalancer", "DNSName"]}}, "ClusterName": {"Value": {"Ref": "Cluster"}}, "ServiceName": {"Value": {"Fn::GetAtt": ["Service", "Name"]}}}
}
